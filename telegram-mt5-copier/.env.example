# Copy this file to .env and fill it in. Never commit .env.

# --- Telegram (get API ID/hash at https://my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+919999999999
# Channel(s) to copy: the channel name as shown in Telegram, @username, or numeric ID
# from `python main.py --list-chats`. Comma-separated.
TG_CHANNELS=topg vip

# --- MT5 demo account: the NEW demo account you open in the bot's own MT5 copy ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=MetaQuotes-Demo
# The bot's own MT5 copy made by setup_mt5_copy.bat. Required, so your normal MT5 is never touched.
MT5_PATH=C:\MT5-Copier\terminal64.exe

# --- Trade sizing ---
# Fixed lots per signal (split evenly across the TPs)...
LOT_SIZE=0.03
# ...or risk this % of balance per signal using the SL distance (0 = use LOT_SIZE)
RISK_PERCENT=0
MAX_LOT=1.0
# Open at most this many positions per signal (one per TP)
MAX_TPS=3
# SL in points to use when a signal has none (0 = no SL)
DEFAULT_SL_POINTS=0
MAX_SLIPPAGE_POINTS=30
# Broker symbol suffix, e.g. ".m" or "pro" if your broker shows XAUUSD.m
SYMBOL_SUFFIX=

# Ignore messages older than this (avoids replaying old signals after a reconnect)
MAX_SIGNAL_AGE_SEC=120
# true = log what would be traded without sending orders. Set false once parsing looks right.
DRY_RUN=true
